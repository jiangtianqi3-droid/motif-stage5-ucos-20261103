+                        WG_SIZE:tl.constexpr):
+    # Each program owns one partial sum. No atomic additions in forward.
+    chunk=tl.program_id(0)
+    start=tl.load(starts+chunk); end=tl.load(ends+chunk)
+    feature=tl.arange(0,WG_SIZE)+tl.program_id(1)*WG_SIZE
